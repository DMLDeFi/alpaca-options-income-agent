# Newer Alpaca MCP server / tooling
ALPACA_API_KEY=your_alpaca_paper_key_id
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_PAPER_TRADE=true

# Legacy Alpaca SDK/CLI naming (same credentials, kept for compatibility)
APCA_API_KEY_ID=your_alpaca_paper_key_id
APCA_API_SECRET_KEY=your_alpaca_paper_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Agent runtime settings
ALPACA_CLI_PATH=alpaca
AGENT_DRY_RUN=true

# From `claude setup-token` (Claude Pro/Max subscription, no separate API billing).
# Leave blank to use the rule-based fallback instead.
CLAUDE_CODE_OAUTH_TOKEN=
